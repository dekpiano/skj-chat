# System & Environment
.env
.env.backup
.env.*.local
/assets

# Composer
vendor/
composer.phar
composer.lock

# CodeIgniter Writable
writable/cache/*
!writable/cache/index.html
!writable/cache/.gitkeep
writable/debugbar/*
writable/logs/*
!writable/logs/index.html
!writable/logs/.gitkeep
writable/session/*
!writable/session/index.html
!writable/session/.gitkeep
writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep

# IDE & OS
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
